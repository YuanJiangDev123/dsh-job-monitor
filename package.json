{
  "name": "dsh-job-monitor",
  "version": "3.6.0",
  "description": "Dedicated background-job dashboard for DSH: all sessions, progress, grouping, and live output.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuanJiangDev123/dsh-job-monitor.git"
  },
  "homepage": "https://github.com/YuanJiangDev123/dsh-job-monitor#readme",
  "bugs": {
    "url": "https://github.com/YuanJiangDev123/dsh-job-monitor/issues"
  },
  "keywords": [
    "dsh",
    "dsh-bundle",
    "deepseek-harness",
    "background-jobs",
    "job-monitor",
    "progress",
    "dashboard"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test scripts/test-helpers.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-job-controller"
      ]
    }
  }
}
